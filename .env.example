# Copy to .env and adjust. Values below match `make dev-up` (docker-compose.yml).

# Postgres connection string. migrate/admin connect as the schema owner and
# need this one.
DATABASE_URL=postgres://recruiting:recruiting@localhost:5433/recruiting?sslmode=disable

# serve/worker refuse the schema owner (it would bypass row-level security)
# and connect as app_rw instead. Optional: defaults to DATABASE_URL with the
# user/password swapped to app_rw/app_rw, so it only needs setting here if
# your app_rw credentials or host differ from DATABASE_URL's.
# DATABASE_URL_APP=postgres://app_rw:app_rw@localhost:5433/recruiting?sslmode=disable

# S3-compatible object storage (MinIO in development).
BLOB_ENDPOINT=http://localhost:9000
BLOB_BUCKET=recruiting
BLOB_KEY=recruiting
BLOB_SECRET=recruiting-secret

# Outbound SMTP (Mailpit in development; web UI on http://localhost:8025).
SMTP_URL=smtp://localhost:1025

# Sandboxed execution service, reached only from the worker.
RUNNER_URL=http://localhost:8081
RUNNER_SECRET=change-me-runner-secret

# Runner capacity: executions at once, requests held waiting for a slot
# (default 4x the concurrency), and how long each waits before a 503.
# RUNNER_MAX_CONCURRENT=2
# RUNNER_MAX_QUEUE=8
# RUNNER_QUEUE_WAIT=20s
# Exit 0 after this long with nothing running or queued, for an
# orchestrator that starts runners on demand (docs/runner-scaling.md).
# RUNNER_IDLE_EXIT=10m
# Byte bound on the runner's result cache.
# RUNNER_CACHE_MB=64
# How many runner.execute jobs one worker runs at once; the runner queues
# the rest, so this needs to cover its capacity plus queue, not more.
# WORKER_RUNNER_CONCURRENCY=4

# Cookie signing key for server-side sessions.
SESSION_SECRET=change-me-session-secret

# Public origin used to build links in emails and magic links.
BASE_URL=http://localhost:8080

# Interview rooms hand these ICE servers to the browser (JSON array). Unset
# leaves host candidates only, which is enough on one network.
# RTC_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"}]

# The browser automation the worker posts jobs with (tools/jobpost). Unset
# records every posting as failed with a reason. The tool reads board
# credentials (LINKEDIN_EMAIL/PASSWORD, INDEED_EMAIL/PASSWORD) and the demo
# board's address (JOBPOST_DEMO_BOARD_URL) from the worker's environment.
# JOBPOST_CMD=node tools/jobpost/cli.js
