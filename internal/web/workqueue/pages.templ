package workqueue

import (
	"recruiting/internal/service"
	"recruiting/internal/web/intake"
	"recruiting/internal/web/layout"
)

// queuePage is every pending action across the org: one row per thing only a
// person can decide, most overdue first.
templ queuePage(page layout.Page, v queueView, csrf string) {
	@layout.Base(page) {
		<div class="page-head">
			<div>
				<p class="page-kicker">Work queue</p>
				<h1>Everything waiting on someone</h1>
				<p class="muted">
					{ itoa(v.Total()) } open across the org
					if v.Overdue() > 0 {
						&middot; { itoa(v.Overdue()) } past their moment
					}
				</p>
			</div>
			<div class="page-actions queue-filters">
				for _, c := range v.Chips() {
					<a class={ "btn", "queue-filter", templ.KV("on", c.Active) } href={ templ.SafeURL(c.Href) }>
						{ c.Label } <span class="num muted">{ itoa(c.Count) }</span>
					</a>
				}
			</div>
		</div>
		if len(v.Items) == 0 {
			<div class="panel empty-card">
				<h2>Nothing is waiting on you</h2>
				<p class="muted">Scored sittings, lapsing invites, client questions, unsent shortlists and missing scorecards all land here.</p>
				<a class="btn btn-primary" href={ templ.SafeURL(intake.StartPath) }>Start a client intake</a>
			</div>
		} else {
			<ul class="queue">
				for _, item := range v.Items {
					@queueRow(item, v.Back(), csrf)
				}
			</ul>
		}
	}
}

// queueRow is one action: what kind of work it is, who it concerns, where it
// belongs, when it was due, and the two things that can be done about it.
templ queueRow(item service.QueueItem, back string, csrf string) {
	<li class="queue-row">
		<span class={ "tag", "queue-kind", "queue-kind-" + string(item.Kind) }>{ kindLabel(item.Kind) }</span>
		<div class="queue-subject">
			<span class="queue-who">{ item.Who }</span>
			<span class="row-note">{ item.Detail }</span>
		</div>
		<div class="queue-where">
			<span class="queue-job">{ item.JobTitle }</span>
			<span class="row-note">{ item.ClientName }</span>
		</div>
		<span class={ "queue-due", "num", templ.KV("late", overdue(item)) }>{ due(item) }</span>
		<div class="row-actions">
			<a class="btn btn-primary" href={ templ.SafeURL(item.ActionURL) }>{ item.ActionLabel }</a>
			<form method="post" action={ templ.SafeURL(SnoozePath) }>
				@layout.CSRFField(csrf)
				<input type="hidden" name="kind" value={ string(item.Kind) }/>
				<input type="hidden" name="subject_id" value={ item.SubjectID.String() }/>
				<input type="hidden" name="back" value={ back }/>
				<button class="btn btn-quiet" type="submit">Snooze 24h</button>
			</form>
		</div>
	</li>
}
