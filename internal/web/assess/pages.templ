package assess

import (
	"fmt"
	"recruiting/internal/service"
	"recruiting/internal/web/layout"
	"recruiting/internal/web/middleware"
)

// candidateShell is the chrome of the candidate pages: no navigation, no
// sign-out, and the island script from the binary's own assets.
templ candidateShell(title string, island bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href={ layout.NocturnePath }/>
			<link rel="stylesheet" href={ layout.AppCSSPath }/>
			if island {
				<script src={ layout.AssessPath } defer></script>
			}
		</head>
		<body>
			<main class="assess-main">
				{ children... }
			</main>
		</body>
	</html>
}

templ sessionPage(s service.AttemptSession, cfgJSON string, csrf string) {
	@candidateShell(s.Assessment.Name, needsIsland(s)) {
		<header class="assess-head">
			<h1>{ s.Assessment.Name }</h1>
			<p class="muted">{ s.JobTitle } · { fmt.Sprintf("%d problems · %d minutes", len(s.Problems), s.Assessment.DurationMinutes) }</p>
		</header>
		switch s.Attempt.Status {
			case service.AttemptInvited:
				if service.ConsentRequired(s.Assessment.Integrity) {
					@configScript(configID, cfgJSON)
					@consentSection(s, csrf)
				} else {
					<section class="assess-intro">
						if s.Assessment.Format == service.AssessmentTakeHome {
							<p>Hi { s.CandidateName }. This is a take-home with { fmt.Sprint(len(s.Problems)) } problem(s). Once you start you have { takeHomeWindow(s.Assessment.DurationMinutes) } to finish; you can close this page and come back through the same link as often as you like until then. Nothing is proctored.</p>
						} else {
							<p>Hi { s.CandidateName }. This assessment has { fmt.Sprint(len(s.Problems)) } problem(s) and a time limit of { fmt.Sprint(s.Assessment.DurationMinutes) } minutes. The clock starts when you press Start and cannot be paused.</p>
						}
						<ul>
							for _, p := range s.Problems {
								<li>{ p.Title } <span class="muted">({ p.Difficulty })</span></li>
							}
						</ul>
						<p>Your invite is valid until { s.Attempt.InviteExpiresAt.Format("2006-01-02 15:04 UTC") }.</p>
						<form method="post" action={ templ.SafeURL(SessionPath + "start") }>
							<input type="hidden" name={ middleware.CSRFField } value={ csrf }/>
							<button type="submit" class="primary">
								if s.Assessment.Format == service.AssessmentTakeHome {
									Start the take-home
								} else {
									Start the assessment
								}
							</button>
						</form>
					</section>
				}
			case service.AttemptStarted:
				@configScript(configID, cfgJSON)
				<div id="assess"></div>
				<noscript><p class="assess-banner">This assessment needs JavaScript enabled.</p></noscript>
			default:
				<section class="assess-intro">
					<p>Thank you, { s.CandidateName }. Your work has been submitted for review.</p>
				</section>
		}
	}
}

templ closedPage(title, msg string) {
	@candidateShell(title, false) {
		<section class="assess-intro">
			<h1>{ title }</h1>
			<p>{ msg }</p>
		</section>
	}
}

// consentSection is the candidate's first screen when the assessment records
// anything: a plain ledger of what is collected, the camera check the island
// fills in, and one answer to give. Without the island the ledger and both
// answers still work; only the camera needs script.
templ consentSection(s service.AttemptSession, csrf string) {
	<section class="consent">
		<p class="consent-kicker">Before the clock starts</p>
		<h2 class="consent-title">What this assessment records</h2>
		<p class="consent-lede">
			Hi { s.CandidateName }. This is a recorded assessment: { fmt.Sprintf("%d problem(s), %d minutes", len(s.Problems), s.Assessment.DurationMinutes) }.
			Everything below is collected only while it is open, and nothing at all is collected until you agree.
		</p>
		<ul class="consent-ledger">
			<li>
				<span class="consent-what">Your work</span>
				<span class="consent-how">What you type in the editor, and each time you run or submit.</span>
			</li>
			if s.Assessment.Integrity.Webcam {
				<li>
					<span class="consent-what">Camera</span>
					<span class="consent-how">
						A still photo of you roughly every { fmt.Sprint(s.Assessment.Integrity.WebcamEvery) } seconds, shown to the people reviewing your assessment. No sound, and no recording of your screen.
					</span>
				</li>
			}
			if s.Assessment.Integrity.PhotoID {
				<li>
					<span class="consent-what">Photo ID</span>
					<span class="consent-how">One still of a photo ID you hold up to the camera, so the reviewer knows who sat the assessment.</span>
				</li>
			}
			if s.Assessment.Integrity.Fullscreen {
				<li>
					<span class="consent-what">Fullscreen</span>
					<span class="consent-how">The assessment opens fullscreen. You can leave it at any time; the recording notes when you do.</span>
				</li>
			}
			if s.Assessment.Integrity.BlockPaste {
				<li>
					<span class="consent-what">Pasting</span>
					<span class="consent-how">Pasting into the editor is turned off. An attempt to paste is noted, never what you tried to paste.</span>
				</li>
			}
		</ul>
		<p class="consent-not">Not collected: your microphone, your screen, your files, or anything outside this page.</p>
		<div id="assess-consent-camera" class="consent-camera" hidden></div>
		<p id="assess-consent-status" class="consent-status" role="status" aria-live="polite"></p>
		if s.Assessment.Integrity.Webcam {
			<noscript>
				<p class="consent-status">The camera check needs JavaScript. Turn it on and reload this page.</p>
			</noscript>
		}
		<form id="assess-consent-form" class="consent-form" method="post" action={ templ.SafeURL(ConsentPath) }>
			<input type="hidden" name={ middleware.CSRFField } value={ csrf }/>
			<label class="consent-agree">
				<input id="assess-consent-agree" type="checkbox" name="agree" required/>
				<span>I have read what is recorded and agree to it.</span>
			</label>
			<div class="consent-actions">
				<button id="assess-consent-start" type="submit" name="decision" value="agree">Start the assessment</button>
				<button type="submit" name="decision" value="decline" class="consent-decline" formnovalidate>Decline and exit</button>
			</div>
		</form>
		<p class="muted">Your invite is valid until { s.Attempt.InviteExpiresAt.Format("2006-01-02 15:04 UTC") }.</p>
	</section>
}
