package pipeline

import (
	"recruiting/internal/domain"
	"github.com/google/uuid"

	"recruiting/internal/service"
	"recruiting/internal/web/layout"
	"recruiting/internal/web/pool"
	"recruiting/internal/web/reviews"
	"recruiting/internal/web/room"
	"recruiting/internal/web/scorecards"
	"recruiting/internal/web/shortlist"
	"recruiting/internal/web/sprints"
)

templ boardPage(page layout.Page, board service.Board, csrf string, problem moveProblem) {
	@layout.Base(page) {
		<h1>{ board.Job.Title }</h1>
		<p class="muted">
			{ board.Job.ClientCompanyName }
			&middot; <a href={ templ.SafeURL(listPath(board.Job.ID)) }>List view</a>
			&middot; <a href={ templ.SafeURL("/app/jobs/" + board.Job.ID.String() + "/pipeline") }>Edit pipeline</a>
			&middot; <a href={ templ.SafeURL(shortlist.Path(board.Job.ID)) }>Shortlist builder</a>
		</p>
		@boardView(board, csrf, problem)
		@boardScript()
	}
}

// boardView is the htmx swap target: every drag re-renders it, and a refused
// move re-renders it with the prompt for a reason or an override.
templ boardView(board service.Board, csrf string, problem moveProblem) {
	<section id="board" x-data="board()">
		if !problem.Empty() {
			@movePrompt(problem, csrf, "board")
		}
		<div class="columns">
			for _, col := range board.Columns {
				<div
					class="column"
					data-stage={ col.Stage.ID.String() }
					@dragover.prevent
					@drop.prevent={ "drop('" + col.Stage.ID.String() + "')" }
				>
					<h3>
						{ col.Stage.Name } <span class="muted">{ count(len(col.Cards)) }</span>
						if col.Stage.Kind == domain.StageSprint {
							<a class="column-action" href={ templ.SafeURL(sprints.NewPath(board.Job.ID, col.Stage.ID)) }>Set up sprint</a>
						}
					</h3>
					for _, a := range col.Cards {
						<article
							class={ "board-card", templ.KV("closed", !a.Active()) }
							draggable="true"
							@dragstart={ "dragging = '" + a.ID.String() + "'" }
							@dragend="dragging = null"
						>
							<a href={ templ.SafeURL(applicationPath(a.ID)) }>{ a.CandidateName }</a>
							<div class="muted">{ a.CandidateEmail }</div>
							if !a.Active() {
								<div class="muted">{ string(a.Status) }</div>
							}
							if a.Released {
								<div class="muted">released</div>
							}
						</article>
					}
				</div>
			}
		</div>
	</section>
}

// movePrompt is the retry form for a refused move: the reason field, and the
// override confirmation when a prerequisite is missing. A move that cannot be
// retried (not permitted, or already moved) shows only its message.
templ movePrompt(problem moveProblem, csrf string, view string) {
	if !problem.NeedsReason && !problem.NeedsOverride {
		<p class="flash flash-error" role="alert">{ problem.Message }</p>
	} else {
		<form
			class="stack prompt"
			hx-post={ applicationPath(problem.ApplicationID) + "/move" }
			hx-target="#board"
			hx-swap="outerHTML"
			method="post"
			action={ templ.SafeURL(applicationPath(problem.ApplicationID) + "/move") }
		>
			@layout.CSRFField(csrf)
			<input type="hidden" name="to_stage_id" value={ problem.ToStageID.String() }/>
			<input type="hidden" name="view" value={ view }/>
			<p class="flash flash-error" role="alert">{ problem.Message }</p>
			<label>Reason <input type="text" name="reason" value={ problem.Reason } required/></label>
			if problem.NeedsOverride {
				<label>
					<input type="checkbox" name="override" value="1" checked/>
					Move anyway, without the stage's scorecard or verdict
				</label>
			}
			<button type="submit">Move</button>
		</form>
	}
}

// boardScript is the drag state: a card is picked up, and dropping it on a
// column posts the move for that column's stage. htmx does not swap a 4xx
// response by default; a 422 carries the retry prompt, so it is let through.
templ boardScript() {
	<script>
		window.board = function () {
			return {
				dragging: null,
				drop(stageId) {
					if (!this.dragging) return;
					const id = this.dragging;
					this.dragging = null;
					htmx.ajax('POST', '/app/applications/' + id + '/move', {
						source: this.$el, target: '#board', swap: 'outerHTML',
						values: { to_stage_id: stageId, view: 'board' },
					});
				},
			};
		};
	</script>
}

templ listPage(page layout.Page, board service.Board, rows []service.Application, f listFilter) {
	@layout.Base(page) {
		<h1>{ board.Job.Title }</h1>
		<p class="muted"><a href={ templ.SafeURL(boardPath(board.Job.ID)) }>Board view</a></p>
		<form class="search" method="get" action={ templ.SafeURL(listPath(board.Job.ID)) }>
			<label>
				Stage
				<select name="stage">
					<option value="">Any stage</option>
					for _, col := range board.Columns {
						<option value={ col.Stage.ID.String() } selected?={ col.Stage.ID.String() == f.StageID }>{ col.Stage.Name }</option>
					}
				</select>
			</label>
			<label>
				Status
				<select name="status">
					<option value="">Any status</option>
					for _, s := range statuses {
						<option value={ string(s) } selected?={ string(s) == f.Status }>{ string(s) }</option>
					}
				</select>
			</label>
			<label>Search <input type="search" name="q" value={ f.Query } placeholder="name or email"/></label>
			<button type="submit">Filter</button>
		</form>
		if len(rows) == 0 {
			<p class="muted">No applications match.</p>
		} else {
			<table>
				<thead>
					<tr><th>Candidate</th><th>Email</th><th>Stage</th><th>Status</th><th>Released</th><th>Applied</th></tr>
				</thead>
				<tbody>
					for _, a := range rows {
						<tr>
							<td><a href={ templ.SafeURL(applicationPath(a.ID)) }>{ a.CandidateName }</a></td>
							<td>{ a.CandidateEmail }</td>
							<td>{ a.StageName }</td>
							<td>{ string(a.Status) }</td>
							<td>
								if a.Released {
									yes
								} else {
									no
								}
							</td>
							<td>{ when(a.CreatedAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

// applicationPage is the candidate detail screen: what the assessment
// recorded, how the candidate fits the job they are on, and the moves open
// on them. vetters is who a recruiter may assign as the interviewer; empty
// hides the assign form.
templ applicationPage(page layout.Page, v candidateView, csrf string, problem moveProblem) {
	@layout.Base(page) {
		if v.Attempt != nil {
			<script src={ layout.ReplayPath } defer></script>
		}
		@candidateHead(v, csrf)
		if !problem.Empty() {
			<p class="flash flash-error" role="alert">{ problem.Message }</p>
		}
		<div class="detail-grid">
			<div class="detail-main">
				if v.Attempt == nil {
					@noAssessmentCard(v, csrf)
				} else {
					@replayPanel(v)
					@submissionPanels(v)
				}
			</div>
			<aside class="detail-side">
				@interviewPanel(v)
				@sprintPanel(v)
				@fitPanel(v)
				@resumePanel(v)
			</aside>
		</div>
		@applicationAdmin(v, csrf, problem)
		@boardScript()
	}
}

// candidateHead names the person, the stage they stand in, and the three
// decisions the screen exists to make.
templ candidateHead(v candidateView, csrf string) {
	<header class="detail-head">
		<div>
			<div class="detail-title">
				<h1>{ v.Detail.Application.CandidateName }</h1>
				<span class="tag tag-accent">{ v.Detail.Application.StageName }</span>
				if !v.Detail.Application.Active() {
					<span class="tag tag-neutral">{ string(v.Detail.Application.Status) }</span>
				}
			</div>
			<p class="muted">
				<a href={ templ.SafeURL("/app/candidates/" + v.Detail.Application.CandidateID.String()) }>{ v.Detail.Application.CandidateEmail }</a>
				&middot; <a href={ templ.SafeURL(boardPath(v.Detail.Application.JobID)) }>{ v.Detail.Application.JobTitle }</a>
				&middot; applied { day(v.Detail.Application.CreatedAt) }
			</p>
		</div>
		<div class="page-actions">
			if v.Detail.Application.Active() && v.Reject.ID != uuid.Nil {
				<form method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/move") }>
					@layout.CSRFField(csrf)
					<input type="hidden" name="to_stage_id" value={ v.Reject.ID.String() }/>
					<button type="submit" class="btn-quiet">Reject</button>
				</form>
			}
			@pool.FlagButton(v.Detail.Application.ID)
			if v.Detail.Application.Active() && v.Advance.ID != uuid.Nil {
				<form method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/move") }>
					@layout.CSRFField(csrf)
					<input type="hidden" name="to_stage_id" value={ v.Advance.ID.String() }/>
					<button type="submit">Advance to { v.Advance.Name }</button>
				</form>
			}
		</div>
	</header>
}

// noAssessmentCard is what stands where the recording would be. Fit rests on
// the résumé alone until there is an exam, and saying so is the point of the
// card.
templ noAssessmentCard(v candidateView, csrf string) {
	<section class="panel empty-card">
		<span class="tag tag-neutral">No assessment yet</span>
		<h2>{ v.Detail.Application.CandidateName } has not sat an assessment</h2>
		<p class="muted">
			Until there is one, the fit beside this rests on the résumé alone. Send the set attached to
			{ v.Detail.Application.JobTitle } and the recording, the code and the case breakdown appear here.
		</p>
		<div class="row-actions">
			<form method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/assessment") }>
				@layout.CSRFField(csrf)
				<button type="submit">Send assessment</button>
			</form>
			<a class="btn-link" href="/app/assessments">Invites in flight</a>
		</div>
	</section>
}

// replayPanel mounts the viewer. Everything under the scrubber — the speeds,
// the integrity timeline, the jump chips — is drawn by the island from the
// manifest and the boot JSON, both of which the server decided.
templ replayPanel(v candidateView) {
	<section class="panel">
		<div class="panel-head">
			<span class="panel-title">Assessment recording</span>
			<span class="muted">{ v.Attempt.StageName } &middot; { at(v.Attempt.FinishedAt) }</span>
			<span class="panel-meta">
				score { scoreOf(v.Attempt.Score) }
				if v.Attempt.RiskScore != nil {
					&middot; risk { scoreOf(v.Attempt.RiskScore) }
				}
			</span>
		</div>
		<div id="replay" class="replay"></div>
		@reviews.ConfigScript("replay-config", v.ReplayConfig)
		<noscript><p class="muted">The replay needs JavaScript enabled. The code and the cases below do not.</p></noscript>
	</section>
}

// submissionPanels are the code each problem was scored on and how every case
// went, side by side, the way the reviewer reads them.
templ submissionPanels(v candidateView) {
	for _, p := range v.Attempt.Problems {
		<div class="detail-pair">
			<section class="panel">
				<div class="panel-head">
					<span class="panel-title">Final submission</span>
					<span class="muted">{ p.Title } &middot; { p.Language }</span>
				</div>
				if p.FinalSource == "" {
					<p class="muted panel-body">Nothing was submitted for this problem.</p>
				} else {
					<pre class="code-final">{ p.FinalSource }</pre>
				}
			</section>
			<section class="panel">
				<div class="panel-head">
					<span class="panel-title">Test results</span>
					<span class="panel-meta num">{ pct(p.Score.Score) }%</span>
				</div>
				<div class="panel-body">
					if len(p.Tests) == 0 {
						<p class="muted">This problem carries no cases.</p>
					} else {
						<table>
							<thead><tr><th>Case</th><th>Class</th><th>Result</th><th>ms</th><th>Weight</th></tr></thead>
							<tbody>
								for _, t := range p.Tests {
									<tr>
										<td>{ caseLabel(t) }</td>
										<td class="muted">{ t.Class }</td>
										<td class={ testResultClass(t.Status) }>{ testResultLabel(t.Status) }</td>
										<td class="num">{ ms(t.TimeMs) }</td>
										<td class="num">{ num(t.Weight) }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</section>
		</div>
	}
}

// interviewPanel is the booked interview: when, with whom, the way into its
// room while it is open, and what was written there afterwards.
templ interviewPanel(v candidateView) {
	if v.Slot != nil {
		<section class="panel interview-panel">
			<div class="panel-head">
				<span class="panel-title">Interview</span>
				<span class="muted">{ v.Slot.StageName }</span>
			</div>
			<div class="panel-body">
				<p><strong>{ when(v.Slot.Start) }</strong> <span class="muted">with { v.Slot.VetterName }</span></p>
				if v.Slot.Video {
					if v.Slot.RoomOpen(v.Now) {
						<a class="btn btn-primary" href={ templ.SafeURL(room.SlotPath(v.Slot.ID)) }>Join room</a>
					} else if v.Slot.Start.After(v.Now) {
						<p class="muted">Video room. Opens at { when(v.Slot.RoomOpensAt()) }.</p>
					} else {
						<p class="muted">Video room, now closed.</p>
					}
				} else {
					<p class="muted">Phone call.</p>
				}
				if v.Slot.HasScorecard {
					<p class="muted">Scorecard filed.</p>
				} else {
					<a class="btn-link" href={ templ.SafeURL(scorecards.FormPath(v.Slot.ApplicationID, v.Slot.StageID)) }>File the scorecard</a>
				}
			</div>
			if v.RoomCode != nil {
				<div class="panel-head">
					<span class="panel-title">Written in the interview</span>
					<span class="muted">{ v.RoomCode.Language } &middot; { when(v.RoomCode.UpdatedAt) }</span>
				</div>
				<pre class="code-final interview-code">{ v.RoomCode.Source }</pre>
			}
		</section>
	}
}

// sprintPanel is what interviewers filed about the candidate in sprints.
templ sprintPanel(v candidateView) {
	if len(v.SprintRatings) > 0 {
		<section class="panel">
			<div class="panel-head">
				<span class="panel-title">Sprint ratings</span>
				<span class="muted">{ count(len(v.SprintRatings)) } filed</span>
			</div>
			<ul class="sprint-ratings">
				for _, r := range v.SprintRatings {
					<li>
						<span class="sprint-score num">{ count(r.Score) }</span>
						<span>
							<span class="sprint-rating-rec">{ recommendationLabel(r.Recommendation) }</span>
							<span class="row-note">{ r.InterviewerName } &middot; <a href={ templ.SafeURL(sprints.Path(r.SprintID)) }>{ r.SprintName }</a></span>
							if r.Note != "" {
								<span class="row-note">{ r.Note }</span>
							}
						</span>
					</li>
				}
			</ul>
		</section>
	}
}

// fitPanel is the ranker's own arithmetic for this one pair, so the number a
// recruiter reads here is the number the suggestions panel would have given.
templ fitPanel(v candidateView) {
	if v.HasFit {
		<section class="panel fit">
			<div class="fit-head">
				<span class="page-kicker">Fit · this job</span>
				<div class="fit-score num">{ fitScore(v.Fit.Score) }</div>
				if v.Fit.Profiled {
					<span class="muted">against the role's skills, rung and place</span>
				} else {
					<span class="muted">no talent-pool profile yet, so only the assessment counts</span>
				}
			</div>
			<div class="fit-terms">
				for _, t := range v.Fit.Terms {
					<div class="fit-term">
						<div class="fit-term-head">
							<span>{ t.Label }</span>
							<span class="muted">{ weightLabel(t.Weight) }</span>
							<span class="num fit-term-value">{ pct(t.Value) }%</span>
						</div>
						<div class="meter"><div class="meter-fill" style={ "width:" + pct(t.Value) + "%" }></div></div>
						<span class="fit-term-note">{ t.Note }</span>
					</div>
				}
			</div>
		</section>
	}
}

// resumePanel is what the candidate sent, newest first.
templ resumePanel(v candidateView) {
	<section class="panel">
		<div class="panel-head"><span class="panel-title">Résumé</span></div>
		<div class="panel-body">
			if len(v.Resumes) == 0 {
				<p class="muted">Nothing on file.</p>
			} else {
				for _, r := range v.Resumes {
					<div class="resume-row">
						<span class="muted num">{ day(r.CreatedAt) }</span>
						<a href={ templ.SafeURL(resumePath(r)) }>{ r.Filename }</a>
					</div>
				}
			}
		</div>
	</section>
}

// applicationAdmin is the rest of the application: who is interviewing, what
// the other stages collected, the moves, and the trail.
templ applicationAdmin(v candidateView, csrf string, problem moveProblem) {
	if len(v.Vetters) > 0 && v.Detail.Application.Active() {
		<h2>Interviewer</h2>
		<form class="stack" method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/assign") }>
			@layout.CSRFField(csrf)
			<label>
				Assign a vetter
				<select name="vetter_id" required>
					for _, vet := range v.Vetters {
						<option value={ vet.ID.String() }>{ userLabel(vet) }</option>
					}
				</select>
			</label>
			<button type="submit">Assign</button>
		</form>
	}
	<h2>Scorecards</h2>
	<div hx-get={ scorecards.SummaryPath(v.Detail.Application.ID) } hx-trigger="load" hx-swap="outerHTML">
		<p class="muted">Loading scorecards…</p>
	</div>
	<h2>Assessments</h2>
	<div hx-get={ reviews.SummaryPath(v.Detail.Application.ID) } hx-trigger="load" hx-swap="outerHTML">
		<p class="muted">Loading assessment results…</p>
	</div>
	if v.Detail.Application.Active() {
		<h2>Move</h2>
		<form class="stack" id="move" method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/move") }>
			@layout.CSRFField(csrf)
			<label>
				To stage
				<select name="to_stage_id" required>
					for _, s := range moveTargets(v.Detail) {
						<option value={ s.ID.String() } selected?={ s.ID == problem.ToStageID }>{ stageLabel(s) }</option>
					}
				</select>
			</label>
			<label>Reason (required to reject or to override) <input type="text" name="reason" value={ problem.Reason }/></label>
			if problem.NeedsOverride {
				<label>
					<input type="checkbox" name="override" value="1" checked/>
					Move anyway, without the stage's scorecard or verdict
				</label>
			} else {
				<label><input type="checkbox" name="override" value="1"/> Override a missing scorecard or verdict</label>
			}
			<button type="submit">Move</button>
		</form>
		<h2>Withdraw</h2>
		<form class="stack" method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/withdraw") }>
			@layout.CSRFField(csrf)
			<label>Reason <input type="text" name="reason"/></label>
			<button type="submit">Mark withdrawn</button>
		</form>
	}
	<h2>Client visibility</h2>
	<p class="muted">
		if v.Detail.Application.Released {
			Released to the client since { when(v.Detail.Application.ReleasedAt) }.
		} else {
			Hidden from the client.
		}
	</p>
	if v.Detail.Application.Released {
		<form method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/unrelease") }>
			@layout.CSRFField(csrf)
			<button type="submit">Hide from client</button>
		</form>
	} else {
		<form method="post" action={ templ.SafeURL(applicationPath(v.Detail.Application.ID) + "/release") }>
			@layout.CSRFField(csrf)
			<button type="submit">Release to client</button>
		</form>
	}
	<h2>Timeline</h2>
	if len(v.Detail.Events) == 0 {
		<p class="muted">Nothing yet.</p>
	} else {
		<ol class="timeline">
			for _, e := range v.Detail.Events {
				<li>
					<span class="muted">{ when(e.CreatedAt) }</span>
					{ eventLine(e) }
					<span class="muted">by { e.ActorKind }</span>
					if e.Reason != "" {
						<div>Reason: { e.Reason }</div>
					}
				</li>
			}
		</ol>
	}
}
