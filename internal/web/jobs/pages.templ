package jobs

import (
	"recruiting/internal/web/stages"
	"github.com/google/uuid"

	"recruiting/internal/service"
	"recruiting/internal/web/layout"
	"recruiting/internal/web/pool"
)

templ jobsPage(page layout.Page, list []service.Job) {
	@layout.Base(page) {
		<h1>Jobs</h1>
		<p><a href={ templ.SafeURL(Prefix + "/new") }>New job</a></p>
		if len(list) == 0 {
			<p class="muted">No jobs yet.</p>
		} else {
			<table>
				<thead>
					<tr><th>Title</th><th>Client</th><th>Seniority</th><th>Status</th><th>Pipeline</th></tr>
				</thead>
				<tbody>
					for _, j := range list {
						<tr>
							<td><a href={ templ.SafeURL(Prefix + "/" + j.ID.String()) }>{ j.Title }</a></td>
							<td>{ j.ClientCompanyName }</td>
							<td>{ j.Seniority }</td>
							<td>{ j.Status }</td>
							<td><a href={ templ.SafeURL(Prefix + "/" + j.ID.String() + "/pipeline") }>Edit pipeline</a></td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ jobFormPage(page layout.Page, f jobForm) {
	@layout.Base(page) {
		if f.Job.ID.String() == "00000000-0000-0000-0000-000000000000" {
			<h1>New job</h1>
		} else {
			<h1>{ f.Job.Title }</h1>
			<p>
				<a href={ templ.SafeURL(Prefix + "/" + f.Job.ID.String() + "/pipeline") }>Edit pipeline</a>
				{ " · " }
				<a href={ templ.SafeURL(Prefix + "/" + f.Job.ID.String() + "/postings") }>Postings</a>
			</p>
		}
		if f.Error != "" {
			<p class="flash flash-error" role="alert">{ f.Error }</p>
		}
		if f.Saved {
			<p class="flash flash-success" role="status">Job saved.</p>
		}
		if len(f.Companies) == 0 {
			<p class="muted">Add a client company under Clients before creating a job.</p>
		}
		<form class="stack" method="post" action={ templ.SafeURL(f.Action) }>
			@layout.CSRFField(page.CSRF)
			<label>
				Client company
				<select name="client_company_id" required>
					<option value="">Choose a client</option>
					for _, c := range f.Companies {
						<option value={ c.ID.String() } selected?={ c.ID == f.Job.ClientCompanyID }>{ c.Name }</option>
					}
				</select>
			</label>
			<label>Title <input type="text" name="title" value={ f.Job.Title } required/></label>
			<label>
				URL slug
				<input type="text" name="slug" value={ f.Job.Slug } placeholder="derived from the title"/>
			</label>
			<label>
				Description (markdown)
				<textarea name="description" rows="8">{ f.Job.Description }</textarea>
			</label>
			<label>
				Required skills (comma separated)
				<input type="text" name="skills" value={ skillsText(f.Job) }/>
			</label>
			<label>
				Seniority
				<select name="seniority">
					<option value="">Unspecified</option>
					for _, s := range service.Seniorities {
						<option value={ s } selected?={ s == f.Job.Seniority }>{ s }</option>
					}
				</select>
			</label>
			<label>Location <input type="text" name="location" value={ f.Job.Location }/></label>
			<label>
				Remote policy
				<select name="remote_policy">
					<option value="">Unspecified</option>
					for _, s := range service.RemotePolicies {
						<option value={ s } selected?={ s == f.Job.RemotePolicy }>{ s }</option>
					}
				</select>
			</label>
			<label>Salary from <input type="number" name="salary_min" min="0" value={ numberValue(f.Job.SalaryMin) }/></label>
			<label>Salary to <input type="number" name="salary_max" min="0" value={ numberValue(f.Job.SalaryMax) }/></label>
			<label>
				<input type="checkbox" name="blind_mode" value="1" checked?={ f.Job.BlindMode }/>
				Blind mode: hide candidate identity from the client until an unblind stage
			</label>
			<label>
				Status
				<select name="status">
					for _, s := range service.JobStatuses {
						<option value={ s } selected?={ s == f.Job.Status }>{ s }</option>
					}
				</select>
			</label>
			<button type="submit">{ f.Submit }</button>
		</form>
		if f.Job.ID != uuid.Nil {
			@pool.SuggestionsFragment(f.Job.ID)
		}
	}
}

templ pipelinePage(page layout.Page, job service.Job, editor stages.Editor) {
	@layout.Base(page) {
		<div class="page-head">
			<div>
				<p class="page-kicker">Pipeline</p>
				<h1>{ job.Title }</h1>
				<p class="muted">
					The stages this job's candidates move through. Edits here change this job only; the process it was built from is unchanged.
					&middot; <a href={ templ.SafeURL(Prefix + "/" + job.ID.String()) }>Job details</a>
					&middot; <a href={ templ.SafeURL("/app/pipeline/" + job.ID.String()) }>Board</a>
				</p>
			</div>
		</div>
		@stages.View(editor)
	}
}
