package problems

import (
	"recruiting/internal/domain"
	"recruiting/internal/service"
	"recruiting/internal/web/layout"
	"recruiting/internal/web/markdown"
)

templ listPage(page layout.Page, f service.ProblemFilter, found []service.Problem) {
	@layout.Base(page) {
		<div class="page-head">
			<div>
				<div class="page-kicker">Library</div>
				<h1>Problem bank</h1>
				<p class="muted">Your org's problems plus the shared platform seed. Platform problems can be used and cloned, never edited.</p>
			</div>
			<div class="page-actions">
				<a class="btn btn-secondary" href={ templ.SafeURL(ImportPath) }>Import JSON batch</a>
				<a class="btn btn-primary" href={ templ.SafeURL(Prefix + "/new") }>New problem</a>
			</div>
		</div>
		<form class="search" method="get" action={ templ.SafeURL(Prefix) }>
			<label>
				Title
				<input type="search" name="q" value={ f.Query } placeholder="meeting rooms"/>
			</label>
			<label>
				Skill tag
				<input type="search" name="tag" value={ f.Tag } placeholder="intervals"/>
			</label>
			<label>
				Difficulty
				<select name="difficulty">
					<option value="">any</option>
					for _, d := range domain.ProblemDifficulties {
						if selected(f.Difficulty, d) {
							<option value={ d } selected>{ d }</option>
						} else {
							<option value={ d }>{ d }</option>
						}
					}
				</select>
			</label>
			<label>
				Kind
				<select name="kind">
					<option value="">any</option>
					for _, k := range domain.ProblemKinds {
						if selected(f.Kind, k) {
							<option value={ k } selected>{ k }</option>
						} else {
							<option value={ k }>{ k }</option>
						}
					}
				</select>
			</label>
			<button type="submit">Filter</button>
		</form>
		if len(found) == 0 {
			<p class="muted">No problem matches that filter. Widen it, or write the problem you were looking for.</p>
		} else {
			<table>
				<thead>
					<tr><th>Problem</th><th>Kind</th><th>Difficulty</th><th>Skills</th><th>Proven in</th><th>Owner</th><th></th></tr>
				</thead>
				<tbody>
					for _, p := range found {
						<tr>
							<td>
								<a href={ templ.SafeURL(problemPath(p)) }>{ p.Title }</a>
								if entrypoint(p) != "" {
									<div class="row-note"><code>{ entrypoint(p) }</code></div>
								}
								if !p.Attachable() {
									<div class="row-note">draft · not attachable yet</div>
								}
							</td>
							<td class="muted">{ p.Kind }</td>
							<td><span class={ "tag", "diff-" + p.Difficulty }>{ p.Difficulty }</span></td>
							<td class="muted">{ tagsText(p) }</td>
							<td>
								@provenBadges(p.ProvenLanguages)
							</td>
							<td class="muted">{ ownerLabel(p) }</td>
							<td class="row-actions">
								<a href={ templ.SafeURL(tryPath(p)) }>Try it</a>
								<form method="post" action={ templ.SafeURL(clonePath(p)) }>
									@layout.CSRFField(page.CSRF)
									<button type="submit" class="btn-link">Clone</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

// provenBadges marks the languages a reference solution has actually passed
// in. A problem with none has never been verified.
templ provenBadges(languages []string) {
	if len(languages) == 0 {
		<span class="muted">not verified</span>
	} else {
		<span class="badges">
			for _, id := range languages {
				<span class="tag tag-accent">{ languageLabel(id) }</span>
			}
		</span>
	}
}

templ detailPage(page layout.Page, p service.Problem) {
	@layout.Base(page) {
		<div class="page-head">
			<div>
				<div class="page-kicker">{ ownerLabel(p) }</div>
				<h1>{ p.Title }</h1>
				<p class="muted">
					{ p.Kind } { " · " } { p.Difficulty }
					if tagsText(p) != "" {
						{ " · " } { tagsText(p) }
					}
				</p>
				if entrypoint(p) != "" {
					<p><code class="entrypoint">{ entrypoint(p) }</code></p>
				}
			</div>
			<div class="page-actions">
				<a class="btn btn-secondary" href={ templ.SafeURL(tryPath(p)) }>Try it</a>
				<form method="post" action={ templ.SafeURL(clonePath(p)) }>
					@layout.CSRFField(page.CSRF)
					<button type="submit">Clone</button>
				</form>
				if !p.Platform() {
					<a class="btn btn-primary" href={ templ.SafeURL(editPath(p)) }>Edit</a>
				}
			</div>
		</div>
		if p.Platform() {
			<p class="muted">This problem belongs to the shared platform bank. Clone it to make it yours.</p>
		}
		if !p.Attachable() {
			<p class="flash flash-error" role="status">
				This problem scores { itoa(p.Quality) } of 100. Below { itoa(domain.ProblemQualityFloor) } it cannot be attached to an assessment, because the scores it produces would say little about a candidate.
			</p>
		}
		<h2>Allowed languages</h2>
		<p>{ languagesText(p) }</p>
		<h2>Proven in</h2>
		<p>
			@provenBadges(p.ProvenLanguages)
		</p>
		<h2>Statement</h2>
		<div class="prose">
			@markdown.Render(p.Statement)
		</div>
		if len(stubLanguages(p)) > 0 {
			<h2>What the candidate starts from</h2>
			<p class="muted">The entrypoint in each allowed language. The candidate fills in the body; the harness calls it with each case's arguments and compares what comes back.</p>
			<div class="stubs">
				for _, lang := range stubLanguages(p) {
					<details class="stub">
						<summary>{ languageLabel(lang) }</summary>
						<pre class="statement">{ p.Stubs()[lang] }</pre>
					</details>
				}
			</div>
		}
		if p.Guidelines != "" {
			<h2>Interviewer guidelines</h2>
			<p class="muted">Internal. A candidate and a client never see this.</p>
			<pre class="statement">{ p.Guidelines }</pre>
		}
		if p.SQLSchema != "" {
			<h2>Schema</h2>
			<pre class="statement">{ p.SQLSchema }</pre>
		}
		if p.SQLSeed != "" {
			<h2>Seed rows</h2>
			<pre class="statement">{ p.SQLSeed }</pre>
		}
		<h2>Reference solutions</h2>
		for _, ref := range p.References {
			<h3>{ languageLabel(ref.Language) }</h3>
			<pre class="statement">{ ref.Source }</pre>
		}
		<h2>Test cases</h2>
		<table>
			<thead>
				<tr><th>#</th><th>Name</th><th>Class</th><th>{ caseInputHeader(p) }</th><th>{ caseExpectedHeader(p) }</th><th>Visibility</th><th>Points</th></tr>
			</thead>
			<tbody>
				for _, c := range p.TestCases {
					<tr>
						<td class="num">{ itoa(c.Position) }</td>
						<td>{ c.Name }</td>
						<td class="muted">{ c.Class }</td>
						<td><pre class="cell">{ c.Input }</pre></td>
						<td><pre class="cell">{ c.Expected }</pre></td>
						<td class="muted">{ c.Visibility }</td>
						<td class="num">{ weightText(c.Weight) }</td>
					</tr>
				}
			</tbody>
		</table>
		if !p.Platform() {
			<form method="post" action={ templ.SafeURL(deletePath(p)) } class="danger-form">
				@layout.CSRFField(page.CSRF)
				<button type="submit">Delete problem</button>
			</form>
		}
		<p><a href={ templ.SafeURL(Prefix) }>Back to the bank</a></p>
	}
}

// formPage is the four-step authoring wizard. Every step's fields are on the
// page at once so one post always carries the whole problem; only the active
// step is shown, and Next stores a draft before moving on.
templ formPage(page layout.Page, f problemForm, problems []string) {
	@layout.Base(page) {
		<div class="page-head">
			<div>
				<div class="page-kicker">
					<a href={ templ.SafeURL(Prefix) }>Problem bank</a>
					if f.New {
						{ " / New" }
					} else {
						{ " / Edit" }
					}
				</div>
				if f.New {
					<h1>Author a problem</h1>
				} else {
					<h1>Edit { f.Title }</h1>
				}
			</div>
			<div class="page-actions">
				<a class="btn btn-secondary" href={ templ.SafeURL(Prefix) }>Discard</a>
			</div>
		</div>
		<form id="authoring" class="authoring" method="post" action={ templ.SafeURL(f.action()) }>
			@layout.CSRFField(page.CSRF)
			@wizard(f, problems)
		</form>
	}
}

// wizard is the swapped region: the step nav, every step's fields, and the
// quality panel that is re-scored on each step.
templ wizard(f problemForm, problems []string) {
	<div id="wizard" class="wizard">
		<input type="hidden" name="id" value={ f.ID.String() }/>
		<input type="hidden" name="step" value={ itoa(f.Step) }/>
		<input type="hidden" name="return" value={ f.Return }/>
		<input type="hidden" name={ langChoiceField } value="1"/>
		<nav class="wizard-steps" aria-label="Authoring steps">
			for _, s := range f.steps() {
				<button
					type="button"
					class={ "wizard-step", templ.KV("active", s.Active), templ.KV("done", s.Done) }
					aria-current?={ s.Active }
					hx-post={ StepPath }
					hx-include="#authoring"
					hx-vals={ stepVals(s.Number) }
					hx-target="#wizard"
					hx-swap="outerHTML"
				>
					<span class="wizard-num">{ itoa(s.Number) }</span>
					<span>{ s.Label }</span>
				</button>
			}
		</nav>
		if len(problems) > 0 {
			<div class="flash flash-error" role="alert">
				<p>The problem was not saved:</p>
				<ul>
					for _, msg := range problems {
						<li>{ msg }</li>
					}
				</ul>
			</div>
		}
		<div class="wizard-body">
			<div class="wizard-panels">
				@stepDetailsPanel(f)
				@stepLanguagesPanel(f)
				@stepCasesPanel(f)
				@stepReferencesPanel(f)
				<div class="wizard-nav">
					if f.prevStep() > 0 {
						<button
							type="button"
							hx-post={ StepPath }
							hx-include="#authoring"
							hx-vals={ stepVals(f.prevStep()) }
							hx-target="#wizard"
							hx-swap="outerHTML"
						>Back</button>
					}
					if f.nextStep() > 0 {
						<button
							type="button"
							class="btn-primary"
							hx-post={ StepPath }
							hx-include="#authoring"
							hx-vals={ stepVals(f.nextStep()) }
							hx-target="#wizard"
							hx-swap="outerHTML"
						>Save draft and continue</button>
					}
					<button type="submit">Verify and save problem</button>
				</div>
			</div>
			@qualityPanel(f)
		</div>
	</div>
}

templ stepDetailsPanel(f problemForm) {
	<section class="wizard-panel" hidden?={ f.Step != stepDetails }>
		<div class="grid-2">
			<label>
				Problem name
				<input type="text" name="title" value={ f.Title } required/>
			</label>
			<label>
				Kind
				<select name="kind" hx-post={ StepPath } hx-include="#authoring" hx-target="#wizard" hx-swap="outerHTML" hx-vals={ stepVals(stepDetails) } hx-trigger="change">
					for _, k := range domain.ProblemKinds {
						if selected(f.Kind, k) {
							<option value={ k } selected>{ kindLabel(k) }</option>
						} else {
							<option value={ k }>{ kindLabel(k) }</option>
						}
					}
				</select>
			</label>
		</div>
		if f.isFunction() {
			@signatureFields(f)
		}
		<label>
			Statement (Markdown)
			<textarea name="statement" rows="12" placeholder="What the candidate has to build, with the constraints that make it interesting.">{ f.Statement }</textarea>
		</label>
		<div class="grid-2">
			<label>
				Difficulty
				<select name="difficulty">
					for _, d := range domain.ProblemDifficulties {
						if selected(f.Difficulty, d) {
							<option value={ d } selected>{ d }</option>
						} else {
							<option value={ d }>{ d }</option>
						}
					}
				</select>
			</label>
			<label>
				Skill tags (comma separated)
				<input type="text" name="tags" value={ f.Tags } placeholder="intervals, sorting"/>
			</label>
		</div>
		<label>
			Interviewer guidelines (internal — never shown to a candidate or a client)
			<textarea name="guidelines" rows="4">{ f.Guidelines }</textarea>
		</label>
		<div class="grid-2">
			<label>
				Time limit per test (ms)
				<input type="number" name="time_limit_ms" value={ itoa(f.TimeLimitMs) }/>
			</label>
			<label>
				Memory limit (kB)
				<input type="number" name="memory_limit_kb" value={ itoa(f.MemoryLimitKB) }/>
			</label>
		</div>
	</section>
}

// signatureFields is the entrypoint editor of a function problem: the name,
// the typed parameters, the return type, and what the stub then reads as.
templ signatureFields(f problemForm) {
	<fieldset class="signature">
		<legend>Entrypoint</legend>
		<p class="muted">The function a candidate implements. The harness calls it with each case's arguments; types are the platform's, spelled per language in the stub.</p>
		<div class="grid-2">
			<label>
				Function name
				<input type="text" name="sig_name" value={ f.SigName } placeholder="receipt_total" required/>
			</label>
			<label>
				Returns
				<select name="sig_returns">
					for _, t := range domain.SignatureTypes {
						if selected(f.SigReturns, t) {
							<option value={ t } selected>{ t }</option>
						} else {
							<option value={ t }>{ t }</option>
						}
					}
				</select>
			</label>
		</div>
		<div class="param-grid">
			for i, p := range f.SigParams {
				<div class="param-row">
					<label>
						Parameter { itoa(i + 1) }
						<input type="text" name={ rowIndex("sig_param_name", i) } value={ p.Name } placeholder="prices"/>
					</label>
					<label>
						Type
						<select name={ rowIndex("sig_param_type", i) }>
							<option value="">—</option>
							for _, t := range domain.SignatureTypes {
								if selected(p.Type, t) {
									<option value={ t } selected>{ t }</option>
								} else {
									<option value={ t }>{ t }</option>
								}
							}
						</select>
					</label>
				</div>
			}
		</div>
		if lang, stub := f.stubPreview(); stub != "" {
			<details class="stub" open>
				<summary>What the candidate starts from ({ lang })</summary>
				<pre class="statement">{ stub }</pre>
			</details>
		}
	</fieldset>
}

templ stepLanguagesPanel(f problemForm) {
	<section class="wizard-panel" hidden?={ f.Step != stepLangs }>
		<p class="muted">The languages a candidate may answer in. "Any" is every language this kind of problem supports. A language reads as proven once one of its reference solutions has passed every case.</p>
		<div class="lang-grid">
			for _, l := range f.languages() {
				<label class={ "lang-option", templ.KV("chosen", l.Chosen) }>
					if l.Chosen {
						<input type="checkbox" name="lang" value={ l.ID } checked/>
					} else {
						<input type="checkbox" name="lang" value={ l.ID }/>
					}
					<span>{ l.Label }</span>
					if l.Proven {
						<span class="lang-note">proven</span>
					}
				</label>
			}
		</div>
		if f.Kind == domain.ProblemKindSQL {
			<div class="grid-2">
				<label>
					Schema
					<textarea name="sql_schema" rows="6">{ f.SQLSchema }</textarea>
				</label>
				<label>
					Seed rows
					<textarea name="sql_seed" rows="6">{ f.SQLSeed }</textarea>
				</label>
			</div>
		} else {
			<input type="hidden" name="sql_schema" value={ f.SQLSchema }/>
			<input type="hidden" name="sql_seed" value={ f.SQLSeed }/>
		}
	</section>
}

templ stepCasesPanel(f problemForm) {
	<section class="wizard-panel" hidden?={ f.Step != stepCases }>
		<p class="muted">
			Every case is scored whole: there is no partial credit inside one.
			Total possible { f.totalPoints() } points.
			if f.isFunction() {
				{ " " } Arguments are a JSON array with one value per parameter; the return value is JSON. Floats compare within a small tolerance, and a map compares by key.
			}
		</p>
		for i, tc := range f.TestCases {
			<fieldset class="case-row">
				<legend>Case { itoa(i + 1) }</legend>
				<div class="grid-4">
					<label>
						Name
						<input type="text" name={ rowIndex("tc_name", i) } value={ tc.Name } placeholder="overlapping intervals"/>
					</label>
					<label>
						Class
						<select name={ rowIndex("tc_class", i) }>
							for _, c := range domain.TestCaseClasses {
								if selected(tc.Class, c) {
									<option value={ c } selected>{ c }</option>
								} else {
									<option value={ c }>{ c }</option>
								}
							}
						</select>
					</label>
					<label>
						Points
						<input type="text" name={ rowIndex("tc_weight", i) } value={ tc.Weight } placeholder="1"/>
					</label>
					<label>
						Visibility
						<select name={ rowIndex("tc_visibility", i) }>
							for _, v := range []string{domain.VisibilityPublic, domain.VisibilityHidden} {
								if selected(tc.Visibility, v) {
									<option value={ v } selected>{ v }</option>
								} else {
									<option value={ v }>{ v }</option>
								}
							}
						</select>
					</label>
				</div>
				<div class="grid-2">
					<label>
						{ f.caseInputLabel() }
						<textarea name={ rowIndex("tc_input", i) } rows="3" placeholder={ f.caseInputPlaceholder() }>{ tc.Input }</textarea>
					</label>
					<label>
						{ f.caseExpectedLabel() }
						<textarea name={ rowIndex("tc_expected", i) } rows="3" placeholder={ f.caseExpectedPlaceholder() }>{ tc.Expected }</textarea>
					</label>
				</div>
				if f.Kind == domain.ProblemKindSQL {
					<label class="check">
						if tc.Unordered {
							<input type="checkbox" name={ rowIndex("tc_unordered", i) } value="1" checked/>
						} else {
							<input type="checkbox" name={ rowIndex("tc_unordered", i) } value="1"/>
						}
						Compare rows in any order
					</label>
				}
			</fieldset>
		}
	</section>
}

templ stepReferencesPanel(f problemForm) {
	<section class="wizard-panel" hidden?={ f.Step != stepRefs }>
		<p class="muted">
			One solution per language you want proven. Verify runs each of them against every case; the problem cannot be saved while one of them fails.
			if f.isFunction() {
				{ " " } A solution is the filled-in entrypoint: the same file a candidate would submit, starting from the stub on step 1.
			}
		</p>
		for i, ref := range f.References {
			<fieldset class="ref-row">
				<legend>Solution { itoa(i + 1) }</legend>
				<label>
					Language ({ languageList() })
					<input type="text" name={ rowIndex("ref_language", i) } value={ ref.Language }/>
				</label>
				<label>
					Source
					<textarea name={ rowIndex("ref_source", i) } rows="10">{ ref.Source }</textarea>
				</label>
			</fieldset>
		}
		<button
			type="button"
			hx-post={ VerifyPath }
			hx-include="#authoring"
			hx-target="#verify"
			hx-swap="innerHTML"
			hx-indicator="#verify"
		>Verify against the runner</button>
		<div id="verify" class="verify"></div>
	</section>
}

// verifyPanel is the per-language, per-case grid step 4 shows after a run.
templ verifyPanel(verdicts []service.ReferenceVerdict, problems []string) {
	if len(problems) > 0 {
		<div class="flash flash-error" role="alert">
			<ul>
				for _, msg := range problems {
					<li>{ msg }</li>
				}
			</ul>
		</div>
	}
	for _, v := range verdicts {
		<section class="verdict">
			<h3>
				{ languageLabel(v.Language) }
				if v.Passed() {
					<span class="tag tag-accent">{ verdictLabel(v) }</span>
				} else {
					<span class="tag tag-outline">{ verdictLabel(v) }</span>
				}
			</h3>
			if v.Err != "" {
				<p class="muted">{ v.Err }</p>
			}
			if v.CompileOutput != "" {
				<pre class="statement">{ v.CompileOutput }</pre>
			}
			<table>
				<thead>
					<tr><th>#</th><th>Case</th><th>Class</th><th>Visibility</th><th>Result</th><th>Time</th><th>Detail</th></tr>
				</thead>
				<tbody>
					for _, c := range v.Cases {
						<tr>
							<td class="num">{ itoa(c.Position) }</td>
							<td>{ c.Name }</td>
							<td class="muted">{ c.Class }</td>
							<td class="muted">{ c.Visibility }</td>
							<td>{ c.Status }</td>
							<td class="num">{ millis(c.TimeMs) }</td>
							<td class="muted">{ c.Detail }</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}

// qualityPanel is the standing verdict on the problem: the same rules an
// assessment applies before it will take the problem at all.
templ qualityPanel(f problemForm) {
	<aside class="quality">
		<div class="quality-head">
			<span>Quality review</span>
			<span class="quality-score">{ itoa(f.qualityScore()) }</span>
		</div>
		<ul class="quality-list">
			for _, c := range f.quality() {
				<li class={ templ.KV("ok", c.OK) }>
					<span class="quality-mark" aria-hidden="true">
						if c.OK {
							✓
						} else {
							○
						}
					</span>
					<span>
						<span class="quality-label">{ c.Label }</span>
						<span class="quality-note">{ c.Note }</span>
					</span>
				</li>
			}
		</ul>
		<p class="quality-foot">A problem below { itoa(domain.ProblemQualityFloor) } can be saved but not attached to an assessment.</p>
	</aside>
}

// tryPage is the candidate's editor pointed at one problem, with nothing
// recorded and nothing stored.
templ tryPage(page layout.Page, p service.Problem, cfgJSON string) {
	@layout.Base(page) {
		<div class="page-head try-head">
			<h1 class="page-kicker">
				<a href={ templ.SafeURL(problemPath(p)) }>{ p.Title }</a>
				{ " / Try it" }
			</h1>
		</div>
		<script src={ layout.AssessPath } defer></script>
		@configScript(configID, cfgJSON)
		<div id="assess" class="try-editor"></div>
		<noscript><p class="flash flash-error">Try it needs JavaScript enabled.</p></noscript>
	}
}

templ importPage(page layout.Page, report domain.ProblemImportErrors, problems []string) {
	@layout.Base(page) {
		<div class="page-head">
			<div>
				<div class="page-kicker">Library</div>
				<h1>Import problems</h1>
				<p class="muted">
					A batch is a JSON array of problems. Every reference solution is run
					against every test case; one failure rejects the whole batch and
					nothing is stored.
				</p>
			</div>
		</div>
		if len(problems) > 0 {
			<div class="flash flash-error" role="alert">
				<ul>
					for _, msg := range problems {
						<li>{ msg }</li>
					}
				</ul>
			</div>
		}
		if len(report) > 0 {
			<div class="flash flash-error" role="alert">
				<p>The batch was rejected. Nothing was imported.</p>
			</div>
			<table>
				<thead>
					<tr><th>#</th><th>Problem</th><th>What is wrong</th></tr>
				</thead>
				<tbody>
					for _, p := range report {
						<tr>
							<td class="num">{ reportPosition(p) }</td>
							<td>{ p.Label() }</td>
							<td>
								<ul>
									for _, msg := range p.Errors {
										<li>{ msg }</li>
									}
								</ul>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<form class="stack" method="post" action={ templ.SafeURL(ImportPath) } enctype="multipart/form-data">
			@layout.CSRFField(page.CSRF)
			<label>
				JSON file
				<input type="file" name="document" accept="application/json,.json"/>
			</label>
			<label>
				…or paste the batch
				<textarea name="document_text" rows="14" placeholder="[ { &#34;kind&#34;: &#34;code&#34;, … } ]"></textarea>
			</label>
			<button type="submit">Import</button>
		</form>
		<p><a href={ templ.SafeURL(Prefix) }>Back to the bank</a></p>
	}
}

templ importedPage(page layout.Page, imported []service.Problem) {
	@layout.Base(page) {
		<h1>Import problems</h1>
		<p class="flash flash-success" role="status">Imported { itoa(len(imported)) } problems.</p>
		<ul>
			for _, p := range imported {
				<li><a href={ templ.SafeURL(problemPath(p)) }>{ p.Title }</a></li>
			}
		</ul>
		<p>
			<a href={ templ.SafeURL(Prefix) }>Back to the bank</a>
			{ " · " }
			<a href={ templ.SafeURL(ImportPath) }>Import another batch</a>
		</p>
	}
}
