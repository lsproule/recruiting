package layout

import "recruiting/internal/web/middleware"

// Base is the chrome every signed-in page renders inside. The stylesheets,
// htmx and Alpine all come from the binary's own assets, never a CDN.
templ Base(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ p.CSRF }/>
			<title>{ p.Title }</title>
			<link rel="stylesheet" href={ NocturnePath }/>
			<link rel="stylesheet" href={ AppCSSPath }/>
			if p.Surface == SurfaceApp {
				@navBoot()
			}
			<script src={ HTMXPath } defer></script>
			<script src={ AlpinePath } defer></script>
		</head>
		<body hx-headers={ csrfHeader(p.CSRF) }>
			if p.Surface == SurfaceApp {
				<div class="shell">
					@sidebar(p)
					<div class="content">
						@pageMain(p) {
							{ children... }
						}
					</div>
				</div>
				@navToggleScript()
			} else {
				@topbar(p)
				@pageMain(p) {
					{ children... }
				}
			}
		</body>
	</html>
}

templ pageMain(p Page) {
	<main>
		for _, f := range p.Flashes {
			<p class={ p.flashClass(f) } role="status">{ f.Message }</p>
		}
		{ children... }
	</main>
}

// sidebar is the recruiter console shell: the five primary destinations with
// their live counts, the intake entry point, and the signed-in user.
templ sidebar(p Page) {
	<aside class="sidebar" id="app-sidebar">
		<div class="sidebar-head">
			<a class="sidebar-brand" href="/app/queue">
				<b>Cadre</b>
				<span>recruiter</span>
			</a>
			<button
				type="button"
				id="nav-toggle"
				class="sidebar-toggle"
				aria-controls="app-sidebar"
				aria-expanded="true"
				aria-label="Collapse navigation"
				title="Collapse navigation"
			>
				@sidebarIcon()
			</button>
		</div>
		{{ counts := p.counts(ctx) }}
		<nav class="sidebar-nav" aria-label="Primary">
			for _, item := range p.Nav {
				if item.Active {
					<a class="nav-item" href={ templ.SafeURL(item.Href) } aria-current="page">
						@NavIcon(item.Key)
						<span>{ item.Label }</span>
						@navCount(counts[item.Key])
					</a>
				} else {
					<a class="nav-item" href={ templ.SafeURL(item.Href) }>
						@NavIcon(item.Key)
						<span>{ item.Label }</span>
						@navCount(counts[item.Key])
					</a>
				}
			}
		</nav>
		<div class="sidebar-foot">
			if p.UserName != "" {
				<a class="btn btn-primary btn-block" href="/app/clients/new">New client intake</a>
				<details class="menu">
					<summary class="sidebar-user">
						<span class="avatar" aria-hidden="true">{ p.initials() }</span>
						<span>
							<span class="who">{ p.UserName }</span>
							if p.UserRole != "" {
								<span class="sidebar-user-role">{ p.UserRole }</span>
							}
						</span>
					</summary>
					<div class="menu-list">
						for _, item := range p.Menu {
							<a href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
						}
						<form method="post" action={ templ.SafeURL(p.LogoutPath()) }>
							@CSRFField(p.CSRF)
							<button type="submit">Sign out</button>
						</form>
					</div>
				</details>
			}
		</div>
	</aside>
}

// navBoot restores the navigation's collapsed state before the first paint,
// so a console that was left collapsed does not open and shut on every load.
// It is the one script that cannot wait for the deferred bundles.
templ navBoot() {
	<script>
		try {
			if (localStorage.getItem('cadre:nav') === 'collapsed') {
				document.documentElement.dataset.nav = 'collapsed';
			}
		} catch (e) {
			/* Storage is walled off in this browser; the console just opens wide. */
		}
	</script>
}

// navToggleScript wires the collapse control. The state lives on the root
// element so the CSS can act on it, and in localStorage so the choice is this
// browser's rather than this page's.
templ navToggleScript() {
	<script>
		(function () {
			const button = document.getElementById('nav-toggle');
			if (!button) return;
			const apply = function (collapsed, remember) {
				if (collapsed) document.documentElement.dataset.nav = 'collapsed';
				else delete document.documentElement.dataset.nav;
				button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
				const label = collapsed ? 'Expand navigation' : 'Collapse navigation';
				button.setAttribute('aria-label', label);
				button.setAttribute('title', label);
				if (!remember) return;
				try {
					localStorage.setItem('cadre:nav', collapsed ? 'collapsed' : 'open');
				} catch (e) {
					/* Nothing to remember it with; the choice lasts this page. */
				}
			};
			apply(document.documentElement.dataset.nav === 'collapsed', false);
			button.addEventListener('click', function () {
				apply(document.documentElement.dataset.nav !== 'collapsed', true);
			});
		})();
	</script>
}

templ navCount(n int) {
	if n > 0 {
		<span class="nav-count">{ n }</span>
	}
}

// topbar is the client portal's and public pages' slim chrome: same tokens,
// no recruiter navigation.
templ topbar(p Page) {
	<header class="topbar">
		<a class="brand" href={ templ.SafeURL(string(p.Surface) + "/") }>Cadre</a>
		<nav>
			for _, item := range p.Nav {
				if item.Active {
					<a href={ templ.SafeURL(item.Href) } aria-current="page">{ item.Label }</a>
				} else {
					<a href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
				}
			}
		</nav>
		if p.UserName != "" {
			<form class="signout" method="post" action={ templ.SafeURL(p.LogoutPath()) }>
				@CSRFField(p.CSRF)
				<span class="who">{ p.UserName }</span>
				<button type="submit">Sign out</button>
			</form>
		}
	</header>
}

// CSRFField is the hidden input every non-htmx form must carry.
templ CSRFField(token string) {
	<input type="hidden" name={ middleware.CSRFField } value={ token }/>
}
